# 从 .env.example 复制此文件为 .env 并填写实际值

# 应用
DEBUG=false

# Redis
REDIS_URL=redis://localhost:6379/0

# 数据库
DATABASE_URL=postgresql+asyncpg://vedic:vedic@localhost:5432/vedic

# Vedic 脚本路径（绝对路径，指向 scripts/ 目录）
# 留空时自动推断（假设 backend/ 与 skills/ 在同一父目录）
VEDIC_SCRIPTS_PATH=

# 报告存储路径
REPORTS_STORAGE_PATH=./storage/reports

# PDF 生成超时（秒）
PDF_TIMEOUT_SECONDS=60

# 排盘缓存过期（秒，默认 24 小时）
CHART_CACHE_TTL=86400

# CORS（逗号分隔，生产环境改为实际域名）
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Phase 2：AI 分析 ────────────────────────────────────────────────────
# Claude（优先，需要 VPN）
# 获取地址：https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# 通义千问（备用，无需 VPN）
QWEN_API_KEY=
QWEN_MODEL=qwen-long

# DeepSeek（备用）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# AI 提供商：auto（有 ANTHROPIC_API_KEY 就用 Claude，否则用 Qwen）
AI_PROVIDER=auto
